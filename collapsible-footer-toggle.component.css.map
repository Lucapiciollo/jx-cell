
    .cft-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 2px 4px;
      color: inherit;
      font: inherit;
      font-weight: 600;
      width: 100%;
      text-align: left;
      border-radius: 3px;
      transition: background 0.15s;
    }
    .cft-btn:hover { background: rgba(255,255,255,0.08); }
    .cft-btn:active { background: rgba(255,255,255,0.15); }

    .cft-icon {
      font-size: 9px;
      opacity: 0.7;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .cft-label {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cft-badge {
      font-size: 10px;
      font-weight: 400;
      opacity: 0.6;
      white-space: nowrap;
      flex-shrink: 0;
    }
  