
    :host { display: block; }
    .jx-num-ghost {
      display: block;
      width: 100%;
      border: none; outline: none;
      background: transparent; color: inherit;
      font: inherit; line-height: normal; text-align: inherit;
      padding: 0; margin: 0;
      box-sizing: border-box;
      cursor: text;
    }
    .jx-num-ghost:disabled { cursor: default; }
  